<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="Test Suite" parallel="tests" thread-count="3"><!--   for parallel testing -->
    <groups>
        <run>
            <include name="smoke" />
        </run>
    </groups>

    <listeners>
        <listener class-name="com.qa.playwright.listeners.ExtentReportListener" />
    </listeners>

    <test name="Swag Lab Login Page Test 1">
        <parameter name="browser" value="chromium" />
        <classes>
<!--            <class name="com.qa.playwright.tests.SwagLabTc.LoginPageTest" />-->
            <class name="com.qa.playwright.tests.SwagLabTc.LeavePageTest" />
        </classes>
    </test>
    <test name="Swag Lab Login Page Test 2">
        <parameter name="browser" value="firefox" />
        <classes>
            <!--            <class name="com.qa.playwright.tests.SwagLabTc.LoginPageTest" />-->
            <class name="com.qa.playwright.tests.SwagLabTc.LeavePageTest" />
        </classes>
    </test>
</suite>